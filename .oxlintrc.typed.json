{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Type-aware gate (`pnpm lint:typed`, runs with --type-aware on TypeScript 7 via oxlint-tsgolint).
  // Only the rules that need type information; `.oxlintrc.json` covers everything else.
  "categories": {
    "correctness": "off"
  },
  "overrides": [
    {
      // Registry source only: vitest/testing-library typings return `any` by design.
      "files": ["registry/**/*.ts", "registry/**/*.tsx"],
      "rules": {
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-argument": "error"
      }
    },
    {
      "files": ["registry/**/*.test.ts", "registry/**/*.test.tsx"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off"
      }
    },
    {
      // An un-awaited render/unmount in a browser test overlaps React act() scopes and breaks every later test in the file.
      "files": ["registry/**/*.browser.test.tsx"],
      "rules": {
        "typescript/no-floating-promises": "error"
      }
    }
  ]
}
