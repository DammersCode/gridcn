// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pivot through the grid function > keeps 1 and "1" apart, binds hostile keys, and never turns another tenant's key into a column > pivot cells 1`] = `"WITH gridcn_page AS (SELECT t.qty AS k FROM public.items AS t WHERE t."tenantId" OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{where,v}') AS pg_catalog.int4) GROUP BY t.qty ORDER BY t.qty ASC NULLS LAST LIMIT ($1 OPERATOR(pg_catalog.->>) 'limit')::pg_catalog.int8 OFFSET ($1 OPERATOR(pg_catalog.->>) 'offset')::pg_catalog.int8) SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('key', s.k, 'count', s.n, 'childCount', s.c, 'aggregates', s.a, 'cells', s.p)), '[]'::pg_catalog.jsonb) FROM (SELECT (t.qty)::pg_catalog.text AS k, pg_catalog.count(*) AS n, pg_catalog.count(*) AS c, pg_catalog.jsonb_build_array((pg_catalog.avg(t.score))::pg_catalog.text) AS a, pg_catalog.to_jsonb(ARRAY[(pg_catalog.avg(t.score) FILTER (WHERE t.name OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{pivot,keys,0,v}') AS pg_catalog.text)))::pg_catalog.text, (pg_catalog.avg(t.score) FILTER (WHERE t.name OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{pivot,keys,1,v}') AS pg_catalog.text)))::pg_catalog.text, (pg_catalog.avg(t.score) FILTER (WHERE t.name OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{pivot,keys,2,v}') AS pg_catalog.text)))::pg_catalog.text, (pg_catalog.avg(t.score) FILTER (WHERE t.name OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{pivot,keys,3,v}') AS pg_catalog.text)))::pg_catalog.text, (pg_catalog.avg(t.score) FILTER (WHERE t.name OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{pivot,keys,4,v}') AS pg_catalog.text)))::pg_catalog.text, (pg_catalog.avg(t.score) FILTER (WHERE t.name OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{pivot,keys,5,v}') AS pg_catalog.text)))::pg_catalog.text, (pg_catalog.avg(t.score) FILTER (WHERE t.name OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{pivot,keys,6,v}') AS pg_catalog.text)))::pg_catalog.text]::pg_catalog.text[]) AS p FROM public.items AS t WHERE (t."tenantId" OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{where,v}') AS pg_catalog.int4)) AND ((t.qty) OPERATOR(pg_catalog.=) ANY (SELECT gp.k FROM gridcn_page AS gp) OR ((t.qty) IS NULL AND EXISTS (SELECT 1 FROM gridcn_page AS gp WHERE gp.k IS NULL))) GROUP BY t.qty ORDER BY t.qty ASC NULLS LAST) s"`;

exports[`pivot through the grid function > keeps 1 and "1" apart, binds hostile keys, and never turns another tenant's key into a column > pivot keys 1`] = `"SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('key', s.k, 'total', s.n)), '[]'::pg_catalog.jsonb) FROM (SELECT (CASE WHEN (t.name)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.name)::pg_catalog.text END)::pg_catalog.text AS k, pg_catalog.count(*) OVER () AS n FROM public.items AS t WHERE t."tenantId" OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{where,v}') AS pg_catalog.int4) GROUP BY CASE WHEN (t.name)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.name)::pg_catalog.text END ORDER BY CASE WHEN (t.name)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.name)::pg_catalog.text END ASC NULLS LAST LIMIT LEAST(($1 OPERATOR(pg_catalog.->>) 'limit')::pg_catalog.int8, 200)) s"`;
