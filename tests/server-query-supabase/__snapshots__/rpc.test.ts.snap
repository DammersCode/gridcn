exports[`hostile plans sent straight to the wrapper > quotes allowed names that look like SQL or shadow the statement's own aliases > odd names 1`] = `"SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('key', s.k, 'count', s.n, 'childCount', s.c, 'aggregates', s.a)), '[]'::pg_catalog.jsonb) FROM (SELECT (t.k)::pg_catalog.text AS k, pg_catalog.count(*) AS n, pg_catalog.count(DISTINCT t.t) OPERATOR(pg_catalog.+) COALESCE(pg_catalog.max(CASE WHEN t.t IS NULL THEN 1 ELSE 0 END), 0) AS c, pg_catalog.jsonb_build_array((pg_catalog.sum(t."a""b; drop table items; --"))::pg_catalog.text) AS a FROM public.odd AS t WHERE TRUE GROUP BY t.k ORDER BY t.k ASC NULLS LAST LIMIT ($1 OPERATOR(pg_catalog.->>) 'limit')::pg_catalog.int8 OFFSET ($1 OPERATOR(pg_catalog.->>) 'offset')::pg_catalog.int8) s"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > aggregates 1`] = `"SELECT pg_catalog.jsonb_build_array((pg_catalog.sum(t.qty))::pg_catalog.text, (pg_catalog.min(CASE WHEN (t.name)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.name)::pg_catalog.text END))::pg_catalog.text) FROM public.items AS t WHERE TRUE"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > groupCount 1`] = `"SELECT pg_catalog.to_jsonb(pg_catalog.count(DISTINCT CASE WHEN (t.tag)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.tag)::pg_catalog.text END) OPERATOR(pg_catalog.+) COALESCE(pg_catalog.max(CASE WHEN CASE WHEN (t.tag)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.tag)::pg_catalog.text END IS NULL THEN 1 ELSE 0 END), 0)) FROM public.items AS t WHERE FALSE"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > groups 1`] = `"SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('key', s.k, 'count', s.n, 'childCount', s.c, 'aggregates', s.a)), '[]'::pg_catalog.jsonb) FROM (SELECT (CASE WHEN (t.tag)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.tag)::pg_catalog.text END)::pg_catalog.text AS k, pg_catalog.count(*) AS n, pg_catalog.count(DISTINCT t.active) OPERATOR(pg_catalog.+) COALESCE(pg_catalog.max(CASE WHEN t.active IS NULL THEN 1 ELSE 0 END), 0) AS c, pg_catalog.jsonb_build_array((pg_catalog.max(t."createdAt"))::pg_catalog.text) AS a FROM public.items AS t WHERE t.price OPERATOR(pg_catalog.>=) CAST(($1 OPERATOR(pg_catalog.#>>) '{where,v}') AS pg_catalog."numeric") GROUP BY CASE WHEN (t.tag)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.tag)::pg_catalog.text END ORDER BY CASE WHEN (t.tag)::pg_catalog.text OPERATOR(pg_catalog.=) '' THEN NULL ELSE (t.tag)::pg_catalog.text END DESC NULLS LAST LIMIT ($1 OPERATOR(pg_catalog.->>) 'limit')::pg_catalog.int8 OFFSET ($1 OPERATOR(pg_catalog.->>) 'offset')::pg_catalog.int8) s"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > rows 1`] = `"SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.to_jsonb(r)), '[]'::pg_catalog.jsonb) FROM (SELECT (t.id)::pg_catalog.text AS id, t."createdAt" AS "createdAt" FROM public.items AS t WHERE (t."tenantId" OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{where,and,0,v}') AS pg_catalog.int4) AND ((t.name)::pg_catalog.text OPERATOR(pg_catalog.~~*) ($1 OPERATOR(pg_catalog.#>>) '{where,and,1,or,0,v}') OR (t.name)::pg_catalog.text OPERATOR(pg_catalog.~~*) ($1 OPERATOR(pg_catalog.#>>) '{where,and,1,or,1,v}') OR (t.name)::pg_catalog.text OPERATOR(pg_catalog.~~*) ($1 OPERATOR(pg_catalog.#>>) '{where,and,1,or,2,v}') OR (t.name)::pg_catalog.text OPERATOR(pg_catalog.~~*) ($1 OPERATOR(pg_catalog.#>>) '{where,and,1,or,3,v}')) AND (NOT t.tag OPERATOR(pg_catalog.=) ANY (CAST(ARRAY(SELECT pg_catalog.jsonb_array_elements_text($1 OPERATOR(pg_catalog.#>) '{where,and,2,not,v}')) AS pg_catalog.text[])))) ORDER BY t.name DESC NULLS LAST, t.id ASC NULLS LAST LIMIT ($1 OPERATOR(pg_catalog.->>) 'limit')::pg_catalog.int8 OFFSET ($1 OPERATOR(pg_catalog.->>) 'offset')::pg_catalog.int8) r"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > values 1`] = `"SELECT COALESCE(pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('value', s.v, 'count', s.n)), '[]'::pg_catalog.jsonb) FROM (SELECT ((pg_catalog.timezone($1 OPERATOR(pg_catalog.->>) 'zone', t."createdAt"))::pg_catalog.date)::pg_catalog.text AS v, pg_catalog.count(*) AS n FROM public.items AS t WHERE ((NOT t.tag OPERATOR(pg_catalog.=) CAST(($1 OPERATOR(pg_catalog.#>>) '{where,v}') AS pg_catalog.text)) AND ((pg_catalog.timezone($1 OPERATOR(pg_catalog.->>) 'zone', t."createdAt"))::pg_catalog.date)::pg_catalog.text OPERATOR(pg_catalog.~~*) ($1 OPERATOR(pg_catalog.->>) 'pattern')) GROUP BY (pg_catalog.timezone($1 OPERATOR(pg_catalog.->>) 'zone', t."createdAt"))::pg_catalog.date ORDER BY 2 DESC, 1 LIMIT ($1 OPERATOR(pg_catalog.->>) 'limit')::pg_catalog.int8) s"`;
