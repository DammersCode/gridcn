// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`hostile plans sent straight to the wrapper > quotes allowed names that look like SQL or shadow the statement's own aliases > odd names 1`] = `"SELECT coalesce(jsonb_agg(jsonb_build_object('key', s.k, 'count', s.n, 'childCount', s.c, 'aggregates', s.a)), '[]'::jsonb) FROM (SELECT (t.k)::text AS k, count(*) AS n, COUNT(DISTINCT t.t) + COALESCE(MAX(CASE WHEN t.t IS NULL THEN 1 ELSE 0 END), 0) AS c, jsonb_build_array((SUM(t."a""b; drop table items; --"))::text) AS a FROM odd AS t WHERE TRUE GROUP BY t.k ORDER BY t.k ASC NULLS LAST LIMIT ($1 ->> 'limit')::bigint OFFSET ($1 ->> 'offset')::bigint) s"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > aggregates 1`] = `"SELECT jsonb_build_array((SUM(t.qty))::text, (MIN(NULLIF((t.name)::text, '')))::text) FROM items AS t WHERE TRUE"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > groupCount 1`] = `"SELECT to_jsonb(COUNT(DISTINCT NULLIF((t.tag)::text, '')) + COALESCE(MAX(CASE WHEN NULLIF((t.tag)::text, '') IS NULL THEN 1 ELSE 0 END), 0)) FROM items AS t WHERE FALSE"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > groups 1`] = `"SELECT coalesce(jsonb_agg(jsonb_build_object('key', s.k, 'count', s.n, 'childCount', s.c, 'aggregates', s.a)), '[]'::jsonb) FROM (SELECT (NULLIF((t.tag)::text, ''))::text AS k, count(*) AS n, COUNT(DISTINCT t.active) + COALESCE(MAX(CASE WHEN t.active IS NULL THEN 1 ELSE 0 END), 0) AS c, jsonb_build_array((MAX(t."createdAt"))::text) AS a FROM items AS t WHERE t.price >= CAST(($1 #>> '{where,v}') AS numeric) GROUP BY NULLIF((t.tag)::text, '') ORDER BY NULLIF((t.tag)::text, '') DESC NULLS LAST LIMIT ($1 ->> 'limit')::bigint OFFSET ($1 ->> 'offset')::bigint) s"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > rows 1`] = `"SELECT coalesce(jsonb_agg(to_jsonb(r)), '[]'::jsonb) FROM (SELECT (t.id)::text AS id, t."createdAt" AS "createdAt" FROM items AS t WHERE (t."tenantId" = CAST(($1 #>> '{where,and,0,v}') AS integer) AND ((t.name)::text ILIKE ($1 #>> '{where,and,1,or,0,v}') OR (t.name)::text ILIKE ($1 #>> '{where,and,1,or,1,v}') OR (t.name)::text ILIKE ($1 #>> '{where,and,1,or,2,v}') OR (t.name)::text ILIKE ($1 #>> '{where,and,1,or,3,v}')) AND (NOT t.tag = ANY (CAST(ARRAY(SELECT jsonb_array_elements_text($1 #> '{where,and,2,not,v}')) AS text[])))) ORDER BY t.name DESC NULLS LAST, t.id ASC NULLS LAST LIMIT ($1 ->> 'limit')::bigint OFFSET ($1 ->> 'offset')::bigint) r"`;

exports[`hostile plans sent straight to the wrapper > the statement holds names and paths only, never a value > values 1`] = `"SELECT coalesce(jsonb_agg(jsonb_build_object('value', s.v, 'count', s.n)), '[]'::jsonb) FROM (SELECT (((t."createdAt") AT TIME ZONE ($1 ->> 'zone'))::date)::text AS v, count(*) AS n FROM items AS t WHERE (t.tag <> CAST(($1 #>> '{where,v}') AS text) AND (((t."createdAt") AT TIME ZONE ($1 ->> 'zone'))::date)::text ILIKE ($1 ->> 'pattern')) GROUP BY ((t."createdAt") AT TIME ZONE ($1 ->> 'zone'))::date ORDER BY 2 DESC, 1 LIMIT ($1 ->> 'limit')::bigint) s"`;
