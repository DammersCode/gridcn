generator client {
  provider               = "prisma-client"
  output                 = "./generated/postgresql"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// Mirrors PG_DDL in fixture.ts; the tests create the tables through the raw driver.
model Item {
  id        BigInt    @id
  name      String?
  tag       String?
  score     Float?
  qty       Int?
  active    Boolean?
  price     Decimal?  @db.Decimal(12, 2)
  createdAt DateTime? @db.Timestamptz
  tenantId  Int

  @@map("items")
}

model CursorItem {
  id     BigInt    @id
  name   String?
  qty    Int?
  price  Decimal?
  active Boolean?
  stamp  DateTime? @db.Timestamptz
  tenant Int

  @@map("cursor_items")
}

enum Mood {
  calm
  busy
  Calm
}

model Kind {
  id      BigInt    @id
  ref     String?   @db.Uuid
  mood    Mood?
  amount  Decimal?
  big     BigInt?
  day     DateTime? @db.Date
  milli   DateTime? @db.Timestamptz(3)
  micro   DateTime? @db.Timestamptz(6)
  seconds Int?
  label   String?
  tenant  Int

  @@map("kinds")
}

// The key-type tables of selection.test.ts.
model KText {
  k     String  @id
  label String?

  @@map("k_text")
}

model KUuid {
  k     String  @id @db.Uuid
  label String?

  @@map("k_uuid")
}

model KInt {
  k     Int     @id
  label String?

  @@map("k_int")
}

model KDecimal {
  k     Decimal @id
  label String?

  @@map("k_decimal")
}

model KFloat {
  k     Float   @id
  label String?

  @@map("k_float")
}

model KCase {
  k     String  @id
  label String?

  @@map("k_case")
}
