generator client {
  provider               = "prisma-client"
  output                 = "./generated/sqlite"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "sqlite"
}

// Mirrors SQLITE_DDL in fixture.ts; the tests create the tables through the raw driver.
model Item {
  id        BigInt   @id
  name      String?
  tag       String?
  score     Float?
  qty       Int?
  active    Boolean?
  price     Decimal?
  createdAt String?
  tenantId  Int

  @@map("items")
}

model CursorItem {
  id     BigInt   @id
  name   String?
  qty    Int?
  price  Decimal?
  active Boolean?
  stamp  String?
  tenant Int

  @@map("cursor_items")
}

model Kind {
  id      BigInt    @id
  ref     String?
  mood    String?
  amount  Decimal?
  big     BigInt?
  day     String?
  milli   String?
  micro   String?
  seconds Int?
  label   String?
  tenant  Int

  @@map("kinds")
}
