{
  "modes": [
    {
      "id": "L",
      "label": "Local array",
      "description": "`data` holds every row in memory."
    },
    {
      "id": "PC",
      "label": "Client pagination",
      "description": "`useDataGridPagination` slices `data` into pages.",
      "evidencePattern": "paginat"
    },
    {
      "id": "PS",
      "label": "Server pagination",
      "description": "The server returns one page per request.",
      "evidencePattern": "paginat"
    },
    {
      "id": "Z",
      "label": "Lazy rows",
      "description": "`useDataGridLazyRows` fetches row ranges on scroll.",
      "evidencePattern": "lazy"
    },
    {
      "id": "C",
      "label": "Controlled state",
      "description": "The app owns `sortState`, `filterState` or `searchText`.",
      "evidencePattern": "\\bcontrolled\\b|sortState|filterState|searchText"
    },
    {
      "id": "SS",
      "label": "Server sort",
      "description": "`sortMode=\"server\"`: the grid never reorders `data`.",
      "evidencePattern": "sortMode"
    },
    {
      "id": "FS",
      "label": "Server filter",
      "description": "`filterMode=\"server\"`: the grid never filters `data`.",
      "evidencePattern": "filterMode"
    },
    {
      "id": "API",
      "label": "Own API",
      "description": "`onDataChange` writes through to the app's backend.",
      "evidencePattern": "onDataChange"
    }
  ],
