{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // @shadcn/lint: agent-first Tailwind design-system rules (theme from components.json -> app/global.css).
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "typescript/no-explicit-any": "warn",
    "unicorn/no-new-array": "off",
    "typescript/no-useless-empty-export": "off",
    // Allowlist: real classes the linter's Tailwind worker cannot verify (external CSS or test
    // fixtures) — each one is generated by a library/theme, not a typo:
    // not-prose (tailwindcss typography, loaded via fumadocs), toaster (sonner CSS),
    // auto-type-table (fumadocs-typescript CSS), rdg-light (react-data-grid CSS),
    // inset-*-start-0 (genuine Tailwind v4 logical utilities, unknown to the linter's grammar),
    // my-custom-class (merge-behavior fixture in data-grid.test.tsx).
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "not-prose",
          "toaster",
          "auto-type-table",
          "rdg-light",
          "inset-block-start-0",
          "inset-inline-start-0",
          "my-custom-class"
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    // Layout (margin/width/position) is free; appearance must come from the component's
    // sizes/variants. DataGrid* components forward className via cn() by design, so they
    // intentionally accept restyling (demos rely on e.g. "rounded-none border-none").
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^DataGrid",
            "allow": ["layout", "color", "typography", "spacing", "shape", "effects", "motion"]
          }
        ]
      }
    ]
  },
  "settings": {
    "shadcn": {
      // ui: components.json aliases.ui; componentImports: gridcn registry components
      "ui": "@/components/ui",
      "componentImports": ["^@/registry(/|$)"]
    }
  },
  "overrides": [
    // gridcn blocks and examples compose ui primitives with deliberate classNames (borderless
    // cell inputs, menu padding, truncated values) — they ARE the design system's building
    // blocks, not consumers of it. @shadcn/lint's own setup doc recommends turning no-restyle
    // off inside a project's component directory for the same reason.
    {
      "files": ["registry/default/**"],
      "rules": { "shadcn/no-restyle": "off" }
    },
    // Stock shadcn/ui files that render their own primitives internally (CalendarDayButton
    // renders <Button>, sub-menus render their own Content). Rewriting them would fork the
    // vendor markup and change the design; the linter's setup doc recommends no-restyle off
    // inside the component directory. The other components/ui files stay fully checked.
    {
      "files": [
        "components/ui/calendar.tsx",
        "components/ui/dropdown-menu.tsx",
        "components/ui/context-menu.tsx"
      ],
      "rules": { "shadcn/no-restyle": "off" }
    }
  ],
  "ignorePatterns": [
    "**/worktrees/**",
    ".next/**",
    "out/**",
    "dist/**",
    "coverage/**",
    "public/**",
    ".source/**",
    "references/**",
    "*.tsbuildinfo"
  ]
}
